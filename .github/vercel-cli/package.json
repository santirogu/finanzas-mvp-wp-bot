{
  "name": "vercel-cli-despliegue",
  "private": true,
  "description": "El CLI de Vercel que usa el job de despliegue (.github/workflows/ci.yml), con su versión y la de todas sus dependencias fijas en pnpm-lock.yaml.",
  "packageManager": "pnpm@10.34.6",
  "dependencies": {
    "vercel": "61.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "tar": "7.5.22",
      "minimatch@10": "10.2.6",
      "js-yaml@4": "4.3.2",
      "smol-toml": "1.9.0",
      "path-to-regexp@6": "6.3.0",
      "path-to-regexp@8": "8.4.2",
      "ajv@8": "8.18.0",
      "undici@5": "5.29.0"
    }
  }
}
