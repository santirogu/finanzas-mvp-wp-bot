# Postgres. En local: docker compose up -d. En producción: la URL "pooled" de Supabase o Neon.
DATABASE_URL=postgres://finanzas:finanzas@localhost:5432/finanzas
# Base aislada para las pruebas de integración (pnpm test:int). Debe terminar en _test: se borra en cada corrida.
TEST_DATABASE_URL=postgres://finanzas:finanzas@localhost:5432/finanzas_test

# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública de la app. En Vercel es opcional: se detecta sola (úsala si tienes dominio propio).
BETTER_AUTH_URL=http://localhost:3000

# Bot de WhatsApp: interpretación de mensajes con Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-haiku-5-5 con esfuerzo "low". Compara opciones con `pnpm bot:eval --model ...`
# BOT_MODEL=claude-opus-5-5
# BOT_EFFORT=low

# WhatsApp Cloud API (developers.facebook.com → tu app → WhatsApp)
# Texto que inventas tú; lo pegas también en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Configuración de la app → Básica → Clave secreta de la app. Valida la firma de cada webhook.
WHATSAPP_APP_SECRET=
# WhatsApp → Configuración de la API: token de acceso e identificador del número de teléfono.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número del bot con indicativo, solo dígitos (p. ej. 573001234567). Activa el botón "Abrir WhatsApp".
WHATSAPP_DISPLAY_NUMBER=
# WHATSAPP_GRAPH_VERSION=v26.0
