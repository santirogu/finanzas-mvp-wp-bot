# Postgres. En local: docker compose up -d. En producción: la URL "pooled" de Supabase o Neon.
DATABASE_URL=postgres://finanzas:finanzas@localhost:5432/finanzas

# Genera uno con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pública de la app (en producción, tu dominio)
BETTER_AUTH_URL=http://localhost:3000

# Bot de WhatsApp: interpretación de mensajes con Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Opcional. Por defecto claude-opus-5-5 con esfuerzo "low". Compara opciones con `pnpm bot:eval --model ...`
# BOT_MODEL=claude-haiku-5-5
# BOT_EFFORT=low
