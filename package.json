{
  "name": "finanzas-mvp-wp-bot",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "drizzle-kit migrate && tsx scripts/seed.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "bot:try": "tsx scripts/bot-try.ts",
    "bot:eval": "tsx scripts/bot-eval.ts",
    "test:int": "vitest run --project integration",
    "test:all": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.4",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.4",
      "typed-rest-client>qs": "^6.16.0"
    }
  }
}
