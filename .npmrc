# Cadena de suministro (README → Versiones forzadas de dependencias).
# Una dependencia con scripts de instalación que no esté revisada (pnpm.onlyBuiltDependencies o
# pnpm.ignoredBuiltDependencies en package.json) hace fallar la instalación en vez de ignorarse sin aviso.
strict-dep-builds=true
# Al agregar o actualizar dependencias, no usa versiones publicadas hace menos de 7 días (en minutos):
# los paquetes secuestrados suelen detectarse y retirarse en esos primeros días.
minimum-release-age=10080
